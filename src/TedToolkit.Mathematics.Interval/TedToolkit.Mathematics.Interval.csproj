<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="CodeAnalysis.props" Sdk="TedToolkit.Build.Sdk"/>
  <Import Project="NugetPackage.props" Sdk="TedToolkit.Build.Sdk"/>
  <Import Project="AlmostAllFrameworks.props" Sdk="TedToolkit.Build.Sdk"/>
  <PropertyGroup>
    <TargetFrameworks>$(TargetFrameworks);net11.0</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <Title>TedToolkit.Mathematics.Interval</Title>
    <Description>A small .NET library for working with mathematical intervals and normalized sets of intervals.</Description>
    <NoWarn>$(NoWarn);CA1724</NoWarn>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ZString" />
  </ItemGroup>


  <ItemGroup>
    <None Include="../../.agents/skills/model-interval-boundaries/**/*"
          Pack="true" PackagePath="skills/model-interval-boundaries/" />
  </ItemGroup>
</Project>